@model WebServer.Models.DTO.LoginDto

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/sign-in.css" rel="stylesheet">

<main class="form-signin w-100 m-auto">
    <form asp-action="Login" method="post" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]">

        <h1 class="h3 mb-3 fw-normal">Please sign in</h1>

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-floating">
            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
            <label>Email address</label>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-floating">
            <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
            <label>Password</label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check text-start my-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label class="form-check-label">Remember me</label>
        </div>

        <button class="btn btn-primary w-100 py-2" type="submit">
            Sign in
        </button>

        <div class="mt-3 text-center">
            <text>
                Don't have an account?
            </text>
            <a asp-controller="User" asp-action="Add" class="btn btn-outline-secondary w-100">
                Sign up
            </a>
        </div>

    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}