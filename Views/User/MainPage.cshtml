@model List<WebServer.Models.Entities.User>


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">

    <div class="d-flex gap-2 mb-3">

        <button id="btnBlock" class="btn btn-warning">
            🔒 Block
        </button>

        <button id="btnUnblock" class="btn btn-success">
            🔓 Unblock
        </button>

        <button id="btnDelete" class="btn btn-danger">
            🗑 Delete
        </button>

        <button id="btnDeleteUnverified" class="btn btn-secondary">
            ❌ Remove unverified
        </button>

    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    <input type="checkbox" id="selectAll" />
                </th>
                <th>Email</th>
                <th>Status</th>
                <th>Last Login</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="user-checkbox" value="@user.Id" />
                    </td>
                    <td>@user.Email</td>
                    <td>@user.Status</td>
                    <td>@user.LastLoginTime.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

</div>

<script src="~/js/mainpage.js"></script>